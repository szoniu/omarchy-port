#!/bin/bash

# omarchy:summary=Review and optionally remove orphaned system packages after updates
# omarchy:requires-sudo=true

# omarchy-port: nakładka na /usr/bin/omarchy-update-orphan-pkgs (pacman -Qtdq / -Rns → backend
# dystrybucji: backend_sieroty / backend_usun_sieroty). Sierota = pakiet zainstalowany jako zależność,
# której już nic nie potrzebuje — ta sama definicja co -Qtd w pacmanie; wyjątki dystrybucji (np. jądra
# na Voidzie) opisuje backend. Usuwane są tylko pokazane pakiety, nie wszystkie sieroty.
. /usr/share/omarchy-port/pkg-map.sh

set -e

mapfile -t orphans < <(backend_sieroty)
(( ${#orphans[@]} )) || exit 0

echo -e "\e[32m\nOrphan system packages\e[0m"
printf '  %s\n' "${orphans[@]}"
echo

if [[ ! -t 0 || ! -t 1 ]]; then
  echo "${#orphans[@]} orphaned package(s) found. Re-run omarchy-update-orphan-pkgs in a terminal to review/remove them."
  echo
  exit 0
fi

if ! gum confirm --default=false "Remove ${#orphans[@]} orphaned package(s)?"; then
  echo "Keeping orphaned packages."
  echo
  exit 0
fi

echo -e "\e[32m\nRemoving orphan system packages\e[0m"
port_jako_root backend_usun_sieroty "${orphans[@]}"
echo
