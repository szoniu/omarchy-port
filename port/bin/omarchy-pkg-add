#!/bin/bash
# omarchy-port: nakładka na /usr/bin/omarchy-pkg-add (pacman -S --needed → menedżer pakietów dystrybucji).
# Kontrakt jak w upstreamie: rc 0 tylko gdy po instalacji WSZYSTKIE pakiety są obecne.
. /usr/share/omarchy-port/pkg-map.sh

names=()
for pkg in "$@"; do
  name=$(port_pkg_name "$pkg") || exit 1
  port_pkg_installed "$name" || names+=("$name")
done

# pakiet portu (stan „port” w mapie) instaluje orkiestrator (PKGBUILD), nie menedżer pakietów
for name in "${names[@]}"; do
  if [[ $name == port:* ]]; then
    echo -e "\033[31mError: Package '${name#port:}' is installed by omarchy-port (port/install.sh), not the package manager — run omarchy-update\033[0m" >&2
    exit 1
  fi
done

if (( ${#names[@]} )); then
  port_jako_root backend_pkg_instaluj "${names[@]}" || exit 1
fi

for pkg in "$@"; do
  name=$(port_pkg_name "$pkg" 2>/dev/null)
  if ! port_pkg_installed "$name"; then
    echo -e "\033[31mError: Package '$pkg' ($name) did not install\033[0m" >&2
    exit 1
  fi
done
exit 0
