#!/bin/bash
# omarchy-port: nakładka na /usr/bin/omarchy-version-pkgs (ostatnie „upgraded” z pacman.log → ostatnia
# instalacja lub aktualizacja pakietu dystrybucji, backend_ostatnia_zmiana). Format daty jak upstream.
. /usr/share/omarchy-port/pkg-map.sh
last=$(backend_ostatnia_zmiana) || exit 1
[[ -n $last ]] || exit 1
date -d "@$last" "+%A, %B %d %Y at %H:%M"
