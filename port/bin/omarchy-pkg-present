#!/bin/bash
# omarchy-port (Void): nakładka na /usr/bin/omarchy-pkg-present (pacman -Q → xbps-query).
# rc 0 = wszystkie podane pakiety są zainstalowane.
. /usr/share/omarchy-port/pkg-map.sh
for pkg in "$@"; do
  name=$(port_pkg_name "$pkg" 2>/dev/null) || exit 1
  port_pkg_installed "$name" || exit 1
done
exit 0
