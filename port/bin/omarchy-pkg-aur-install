#!/bin/bash
# omarchy-port (Void): AUR nie istnieje poza Archem. Uczciwa odmowa zamiast cichego sukcesu —
# wołający (np. instalatory aplikacji z menu) ma zobaczyć, czego brakuje.
echo -e "\033[31momarchy-port: AUR niedostępny na Voidzie — pakiet(y): $*\033[0m" >&2
echo "Sprawdź repo Voida (xbps-query -Rs <nazwa>), flatpak albo instalację z upstreamu." >&2
exit 1
