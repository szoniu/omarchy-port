#!/bin/bash

# omarchy:summary=Update mise-managed tools

# omarchy-port (Void): nakładka na /usr/bin/omarchy-update-mise — `mise up --no-prune`. mise z repo
# Voida (2026.8.2) nie zna upgrade.auto_prune=false, którym Omarchy wyłącza usuwanie starej wersji
# narzędzia przy `mise up` (port pomija to ustawienie w user/mise.sh); bez flagi `mise up` kasuje
# wersję, której projekt może jeszcze używać.

if omarchy-cmd-present mise; then
  echo -e "\e[32m\nUpdate mise tools\e[0m"

  # mise withholds releases younger than its cooldown, so tools stay behind for
  # days after they ship. Running omarchy update is the user asking for current
  # versions now, which is the same call the mup alias makes by hand.
  MISE_MINIMUM_RELEASE_AGE=0 mise up --no-prune
fi
