#!/bin/bash
# omarchy-port (Void): nakładka na /usr/bin/omarchy-pkg-missing.
# rc 0 = przynajmniej jednego z podanych pakietów brakuje (pakiet nieistniejący na Voidzie też „brakuje”).
. /usr/share/omarchy-port/pkg-map.sh
for pkg in "$@"; do
  name=$(port_pkg_name "$pkg" 2>/dev/null) || exit 0
  port_pkg_installed "$name" || exit 0
done
exit 1
