#!/bin/bash
# omarchy-port: nakładka na /usr/bin/omarchy-pkg-install — wybór pakietów z repo dystrybucji (fzf) → instalacja.
. /usr/share/omarchy-port/pkg-map.sh
fzf_args=(
  --multi
  --preview "$BACKEND_PODGLAD_REPO"
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

pkg_names=$(backend_pkg_lista_repo | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  mapfile -t names <<<"$pkg_names"
  port_jako_root backend_pkg_instaluj "${names[@]}"
  omarchy-show-done 2>/dev/null || true
fi
