#!/bin/bash
# omarchy-port: `systemctl` dla systemów BEZ systemd (Void/runit). Instalowany TYLKO gdy
# prawdziwego systemctl nie ma — na Gentoo z systemd nie powstaje.
#   zasilanie (reboot/poweroff/suspend/hibernate…) → loginctl (elogind)
#   --user …                                       → omarchy-port-units (nadzorca unitów użytkownika)
#   usługi systemowe                               → runit (/etc/sv, /var/service), mapa nazw w runit-services.tsv
# Usługa świadomie pominięta (kolumna runit = „-”) → rc 0 + wpis w logu; nieznana → rc 5 jak w systemd.
MAP=/usr/share/omarchy-port/runit-services.tsv
SVDIR=/etc/sv
RUNSVDIR=/var/service
if (( EUID == 0 )); then LOGF=/var/log/omarchy-port/systemctl.log
else LOGF="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-port/systemctl.log"; fi
log() { mkdir -p "${LOGF%/*}" 2>/dev/null; printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGF" 2>/dev/null; }

user=0 quiet=0 now=0
rest=()
while (($#)); do
  case $1 in
    --user) user=1 ;;
    --system) user=0 ;;
    -q|--quiet) quiet=1 ;;
    --now) now=1 ;;
    *) rest+=("$1") ;;
  esac
  shift
done
set -- "${rest[@]}"

log "$( ((user)) && echo '--user ')$*"

if ((user)); then
  ((now)) && set -- "$1" --now "${@:2}"
  ((quiet)) && set -- "$1" --quiet "${@:2}"
  exec omarchy-port-units "$@"
fi

verb=${1:-}
shift || true
units=()
for a in "$@"; do [[ $a == -* ]] || units+=("$a"); done

case $verb in
  reboot|poweroff|suspend|hibernate|hybrid-sleep|suspend-then-hibernate)
    exec loginctl "$verb" ;;
  halt) exec loginctl poweroff ;;
  daemon-reload|daemon-reexec|reset-failed) exit 0 ;;
esac

# nazwa runit dla unitu systemd; wypisuje nazwę, „-” (pominięty) albo nic (nieznany)
runit_name() {
  local u=${1%.service}
  u=${u%.socket}; u=${u%.timer}; u=${u%.path}
  local row
  row=$(awk -F'\t' -v s="$u" 'NR > 1 && $1 == s { print $2; exit }' "$MAP" 2>/dev/null)
  if [[ -n $row ]]; then printf '%s\n' "$row"; return; fi
  [[ -d $SVDIR/$u ]] && printf '%s\n' "$u"
}

need_root() {
  if (( EUID != 0 )); then
    echo "Failed to $verb $1: Access denied (omarchy-port: wymaga roota — użyj sudo)" >&2
    exit 4
  fi
}

rc=0
for unit in "${units[@]}"; do
  name=$(runit_name "$unit")
  if [[ $name == - ]]; then
    case $verb in
      is-active) ((quiet)) || echo inactive; rc=3 ;;
      is-enabled) ((quiet)) || echo disabled; rc=1 ;;
      is-failed) rc=1 ;;
      *) ((quiet)) || echo "omarchy-port: $unit — pominięty na runit (zob. $MAP)" >&2
         log "pominięty: $verb $unit" ;;
    esac
    continue
  fi
  if [[ -z $name ]]; then
    case $verb in
      is-active) ((quiet)) || echo inactive; rc=3; continue ;;
      is-enabled) ((quiet)) || echo "Failed to get unit file state for $unit: No such file or directory" >&2; rc=1; continue ;;
      is-failed) rc=1; continue ;;
    esac
    echo "Failed to $verb $unit: Unit $unit not found." >&2
    log "nieznany: $verb $unit"
    rc=5; continue
  fi
  case $verb in
    enable)
      need_root "$unit"
      ln -sfn "$SVDIR/$name" "$RUNSVDIR/$name" || rc=1 ;;
    disable)
      need_root "$unit"
      rm -f "$RUNSVDIR/$name" || rc=1 ;;
    mask)
      need_root "$unit"
      rm -f "$RUNSVDIR/$name"; touch "$SVDIR/$name/down" || rc=1 ;;
    unmask)
      need_root "$unit"
      rm -f "$SVDIR/$name/down" ;;
    start|stop|restart)
      need_root "$unit"
      sv "$verb" "$RUNSVDIR/$name" >/dev/null || rc=1 ;;
    reload)
      need_root "$unit"
      sv hup "$RUNSVDIR/$name" >/dev/null || rc=1 ;;
    try-restart|condrestart)
      need_root "$unit"
      if sv status "$RUNSVDIR/$name" 2>/dev/null | grep -q '^run:'; then sv restart "$RUNSVDIR/$name" >/dev/null || rc=1; fi ;;
    is-active)
      if sv status "$RUNSVDIR/$name" 2>/dev/null | grep -q '^run:'; then ((quiet)) || echo active
      else ((quiet)) || echo inactive; rc=3; fi ;;
    is-enabled)
      if [[ -L $RUNSVDIR/$name ]]; then ((quiet)) || echo enabled
      else ((quiet)) || echo disabled; rc=1; fi ;;
    is-failed) rc=1 ;;
    status)
      sv status "$RUNSVDIR/$name" 2>/dev/null || echo "$unit: wyłączona (brak $RUNSVDIR/$name)"
      sv status "$RUNSVDIR/$name" 2>/dev/null | grep -q '^run:' || rc=3 ;;
    *)
      echo "systemctl (omarchy-port): nieobsługiwane: $verb" >&2
      log "nieobsługiwane: $verb $unit"
      exit 1 ;;
  esac
  # enable --now / disable --now: runit startuje/zatrzymuje przy (od)linkowaniu sam
done
exit $rc
