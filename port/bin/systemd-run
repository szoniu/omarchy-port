#!/bin/bash
# omarchy-port: `systemd-run` dla systemów BEZ systemd. Instalowany TYLKO gdy prawdziwego nie ma.
# Formy używane przez Omarchy:
#   odpal w tle         systemd-run --user --quiet --collect --unit=X [--property=…] cmd…
#   czekaj na wynik     systemd-run --user … cmd… --wait   (albo --wait/--scope przed cmd)
#   opóźnienie (timer)  systemd-run --user … --on-active=2s|5m [--timer-property=…] cmd…
# Timer zostawia ślad w $XDG_RUNTIME_DIR/omarchy-port/timers/<unit>.timer („next pid”),
# który widzi `systemctl --user list-timers/stop` (omarchy-port-units) — tak działają przypomnienia.
# root zawsze w /run/omarchy-port — tam szuka shim systemctl (sudo systemctl is-active/stop X.timer)
if (( EUID == 0 )); then RT=/run/omarchy-port
else RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-port"; fi
if (( EUID == 0 )); then LOGD=/var/log/omarchy-port; else LOGD="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-port"; fi
mkdir -p "$RT/timers" "$RT/units" "$LOGD"

wait=0 user=0 unit='' on_active='' out="$LOGD/systemd-run.log"
while (($#)); do
  case $1 in
    --user) user=1 ;;
    --system|-q|--quiet|-G|--collect|--no-block|--same-dir|-d) ;;
    -W|--wait|--scope|-P|--pipe|-t|--pty) wait=1 ;;
    --unit=*) unit=${1#*=} ;;
    -u|--unit) unit=$2; shift ;;
    --on-active=*) on_active=${1#*=} ;;
    --on-active) on_active=$2; shift ;;
    --property=StandardOutput=null|--property=StandardError=null) out=/dev/null ;;
    -p|--property|--timer-property|--description|--slice|--working-directory|--uid|--gid|--nice) shift ;;
    --property=*|--timer-property=*|--description=*|--slice=*|--working-directory=*|--uid=*|--gid=*|--nice=*) ;;
    -E|--setenv) export "${2?}"; shift ;;
    --setenv=*) export "${1#*=}" ;;
    --on-calendar*|--on-boot*|--on-startup*|--on-unit-active*|--on-unit-inactive*|--on-clock-change|--on-timezone-change|--path-property*|--socket-property*)
      echo "systemd-run (omarchy-port): $1 nieobsługiwane" >&2; exit 1 ;;
    --) shift; break ;;
    -*) echo "systemd-run (omarchy-port): ignoruję nieznaną opcję $1" >&2 ;;
    *) break ;;
  esac
  shift
done
# Jak w systemd-run: opcje kończą się na pierwszym argumencie niebędącym opcją (getopt z „+”),
# więc `… cmd --wait` przekazuje --wait PROGRAMOWI (omarchy-theme-set-hermes go przyjmuje).
cmd=("$@")
(( ${#cmd[@]} )) || { echo "systemd-run (omarchy-port): brak polecenia" >&2; exit 1; }
unit=${unit:-run-$$-$(date +%s%N)}
unit=${unit%.service}

# czas systemd (2s, 5m, 1h30m, 100ms, 1min, 90sec, 3hours, 30) → sekundy (z ułamkiem)
to_seconds() {
  local s=${1// /} total=0 num unit mul
  [[ $s =~ ^[0-9]+$ ]] && { echo "$s"; return; }
  while [[ -n $s ]]; do
    [[ $s =~ ^([0-9]+)([a-z]*)(.*)$ ]] || { echo "systemd-run (omarchy-port): nie rozumiem czasu '$1'" >&2; return 1; }
    num=${BASH_REMATCH[1]} unit=${BASH_REMATCH[2]} s=${BASH_REMATCH[3]}
    case $unit in
      us|usec) mul=0.000001 ;;
      ms|msec) mul=0.001 ;;
      ''|s|sec|second|seconds) mul=1 ;;
      m|min|minute|minutes) mul=60 ;;
      h|hr|hour|hours) mul=3600 ;;
      d|day|days) mul=86400 ;;
      w|week|weeks) mul=604800 ;;
      *) echo "systemd-run (omarchy-port): nieznana jednostka czasu '$unit' w '$1'" >&2; return 1 ;;
    esac
    total=$(awk -v t="$total" -v n="$num" -v m="$mul" 'BEGIN { print t + n * m }')
  done
  echo "$total"
}

if [[ -n $on_active ]]; then
  secs=$(to_seconds "$on_active") || exit 1
  timer="$RT/timers/$unit.timer"
  setsid bash -c 'sleep "$1"; rm -f "$2"; shift 2; exec "$@"' _ "$secs" "$timer" "${cmd[@]}" >>"$out" 2>&1 </dev/null &
  pid=$!
  next=$(awk -v n="$(date +%s)" -v s="$secs" 'BEGIN { printf "%d", n + s + 0.999 }')
  echo "$next $pid" >"$timer"
  disown
  exit 0
fi

if (( wait )); then
  "${cmd[@]}"
  exit $?
fi

setsid "${cmd[@]}" >>"$out" 2>&1 </dev/null &
pid=$!
# unit w tle z --user widoczny dla `systemctl --user is-active/stop <unit>.service` (omarchy-port-units);
# setsid robi z procesu lidera grupy, więc stop zabija całe drzewo (kill -- -pid)
(( user )) && echo "$pid" >"$RT/units/$unit.service.pid"
disown
exit 0
