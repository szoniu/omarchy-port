# Przypięte źródła Omarchy — jedno miejsce prawdy dla port/install.sh.
# Zmiana wersji = te trzy wartości razem (omarchy i omarchy-settings w omarchy-pkgs muszą mieć
# _commit równy OMARCHY_COMMIT — orkiestrator to sprawdza i przerywa przy rozjeździe). Przed zmianą:
# prototyp/bramka/podbicie.sh (nowe migracje i kroki install/ do przejrzenia) i test w VM.
OMARCHY_TAG=v4.0.4
OMARCHY_COMMIT=c668141e9c42b13c80c9ca4ea108e11708c5e8a5
OMARCHY_PKGS_COMMIT=4c51e6b80513ff3bd224bb0e7251f0cfd791cde2
# Skąd pobierać — inne tylko w gałęzi testowej (np. syntetyczne podbicie w VM z lokalnych repo).
OMARCHY_URL=https://github.com/basecamp/omarchy.git
OMARCHY_PKGS_URL=https://github.com/omacom/omarchy-pkgs.git
