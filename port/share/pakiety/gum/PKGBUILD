# omarchy-port: gum z wydania upstreamu (binarka) — na Gentoo nie ma go w ::gentoo, GURU ani hyproverlay
# (omarchy-port#5). Wersja jak w Archu (extra), pod który pisane jest Omarchy; suma = digest pliku z API
# GitHuba (sprawdzona 15.10.2026). Budowane przez port/install.sh (etap 3: zrodla() + package()).
pkgname=gum
pkgver=2.0.2
pkgrel=1
pkgdesc='A tool for glamorous shell scripts'
arch=('x86_64')
url='https://github.com/charmbracelet/gum'
license=('MIT')
source=("https://github.com/charmbracelet/gum/releases/download/v${pkgver}/gum_${pkgver}_Linux_x86_64.tar.gz")
sha256sums=('d842e06d93dbed90af48cb8dd10698db6f22e331fc40346bb37bbc753109edc2')

package() {
  cd "$srcdir/gum_${pkgver}_Linux_x86_64"
  install -Dm755 gum "$pkgdir/usr/bin/gum"
  install -Dm644 completions/gum.bash "$pkgdir/usr/share/bash-completion/completions/gum"
  install -Dm644 completions/gum.zsh "$pkgdir/usr/share/zsh/site-functions/_gum"
  install -Dm644 completions/gum.fish "$pkgdir/usr/share/fish/vendor_completions.d/gum.fish"
  install -Dm644 manpages/gum.1.gz "$pkgdir/usr/share/man/man1/gum.1.gz"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/gum/LICENSE"
}
