# omarchy-port: LocalSend z wydania upstreamu (.deb, aplikacja Fluttera) — na Gentoo nie ma go w ::gentoo,
# GURU ani hyproverlay (omarchy-port#5), a PKGBUILD z omarchy-pkgs buduje go ze źródeł (Flutter + Rust).
# Wersja jak w omarchy-pkgs; suma = digest pliku z API GitHuba (sprawdzona 15.10.2026). Omarchy woła
# `localsend --headless send` (omarchy-menu-share), więc /usr/bin/localsend wskazuje na aplikację.
pkgname=localsend
pkgver=1.18.2
pkgrel=1
pkgdesc='An open source cross-platform alternative to AirDrop'
arch=('x86_64')
url='https://github.com/localsend/localsend'
license=('Apache-2.0')
source=("https://github.com/localsend/localsend/releases/download/v${pkgver}/LocalSend-${pkgver}-linux-x86-64.deb")
sha256sums=('cc42a4f3eacdcb25ec31f0016b1272acb003145ab30484db8965450e20c72cd2')

package() {
  ar p "$srcdir/LocalSend-${pkgver}-linux-x86-64.deb" data.tar.zst | zstd -dc | tar -x -C "$pkgdir" --no-same-owner
  install -d "$pkgdir/usr/bin"
  ln -s /opt/localsend_app/localsend_app "$pkgdir/usr/bin/localsend"
}
